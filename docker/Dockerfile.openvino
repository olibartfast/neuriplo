# docker build --rm -t neuriplo:openvino -f docker/Dockerfile.openvino .
# docker run --rm neuriplo:openvino

# Stage 1: Base image with OpenVINO dependencies
# Prebuilt SDK base override: defaults to the stage below so local builds are
# unchanged; CI passes BASE_IMAGE=ghcr.io/<repo>/openvino-deps:<ver>.
ARG BASE_IMAGE=base
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies.
# libtbb12 is a hard requirement of libopenvino.so (DT_NEEDED libtbb.so.12);
# it used to arrive transitively via libopencv-dev -> libopencv-core410.
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y \
    cmake=3.* \
    build-essential \
    pkg-config \
    wget \
    git \
    curl \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    ninja-build \
    libgoogle-glog-dev \
    libgtest-dev \
    libgmock-dev \
    libtbb12 \
    && rm -rf /var/lib/apt/lists/*

COPY versions.env /tmp/versions.env

# Build GTest static libs
RUN cd /usr/src/gtest && cmake . && make && cp lib/*.a /usr/lib/ || cp *.a /usr/lib/

# Stage 2: Install OpenVINO
FROM ${BASE_IMAGE} AS openvino_install

ENV OPENVINO_DIR=/opt/openvino

# Use the requested repository pin even when inheriting a published SDK.
COPY versions.env /tmp/versions.env

# Download and install OpenVINO
RUN . /tmp/versions.env && \
    if [ -f ${OPENVINO_DIR}/runtime/lib/intel64/libopenvino.so ] && [ "$(cat ${OPENVINO_DIR}/openvino-version.txt 2>/dev/null)" = "${OPENVINO_FULL_ID}" ]; then \
        echo "OpenVINO ${OPENVINO_FULL_ID} already installed, skipping download."; \
    else \
    OPENVINO_FILENAME=openvino_toolkit_ubuntu24_${OPENVINO_FULL_ID}_x86_64.tgz && \
    OPENVINO_SHORT=$(echo ${OPENVINO_VERSION} | cut -d. -f1-2) && \
    wget --tries=3 --retry-connrefused \
    "https://storage.openvinotoolkit.org/repositories/openvino/packages/${OPENVINO_SHORT}/linux/${OPENVINO_FILENAME}" \
    && tar -xzf "${OPENVINO_FILENAME}" -C /opt \
    && rm "${OPENVINO_FILENAME}" \
    && ln -sfn /opt/openvino_toolkit_ubuntu24_${OPENVINO_FULL_ID}_x86_64 /opt/openvino \
    && echo "${OPENVINO_FULL_ID}" > ${OPENVINO_DIR}/openvino-version.txt; \
    fi

# Fail fast if the SDK sentinel or the pin stamp is missing: the skip above
# must stay in sync with the real toolkit layout.
RUN . /tmp/versions.env && \
    test -f ${OPENVINO_DIR}/runtime/lib/intel64/libopenvino.so && \
    test "$(cat ${OPENVINO_DIR}/openvino-version.txt)" = "${OPENVINO_FULL_ID}"

# Set OpenVINO environment variables
ENV PATH=${OPENVINO_DIR}/bin:${OPENVINO_DIR}/python_env/bin:$PATH
ENV LD_LIBRARY_PATH=${OPENVINO_DIR}/lib
ENV PYTHONPATH=${OPENVINO_DIR}/python

# Create a local Python virtual environment for OpenVINO tools
RUN . /tmp/versions.env && \
    if [ "$(${OPENVINO_DIR}/python_env/bin/pip show openvino 2>/dev/null | awk '/^Version: /{print $2}')" = "${OPENVINO_VERSION}" ]; then \
        echo "OpenVINO Python tools already set up, skipping."; \
    else \
    echo "Setting up OpenVINO Python tools..." && \
    rm -rf "${OPENVINO_DIR}/python_env" && \
    python3 -m venv "${OPENVINO_DIR}/python_env" && \
    . "${OPENVINO_DIR}/python_env/bin/activate" && \
    pip install "openvino==${OPENVINO_VERSION}"; \
    fi

# Stage 3: Build application
FROM openvino_install AS builder

WORKDIR /app

# Copy source code
COPY . .

# Build the project with OpenVINO backend and tests enabled
RUN rm -rf build && \
    cmake -Bbuild -H. \
    -DDEFAULT_BACKEND=OPENVINO \
    -DBUILD_INFERENCE_ENGINE_TESTS=ON \
    -DOPENVINO_DIR=${OPENVINO_DIR} \
    && cmake --build build --config Release -j$(nproc)

# Stage 4: Generate test models
FROM builder AS model_generator

# Create virtual environment and install Python dependencies for model generation
RUN python3 -m venv /opt/test_env
ENV PATH=/opt/test_env/bin:$PATH

RUN pip install --upgrade pip && \
    pip install torch torchvision onnx onnxscript numpy \
    pytest pytest-cov pytest-mock pytest-benchmark pytest-xdist \
    coverage pytest-html pytest-json-report

# Copy model generation scripts to build directory
RUN cp backends/openvino/test/export_torchvision_classifier.py build/backends/openvino/test/ && \
    cp backends/openvino/test/generate_openvino_ir.sh build/backends/openvino/test/ && \
    chmod +x build/backends/openvino/test/generate_openvino_ir.sh

# Generate ONNX model and OpenVINO IR
WORKDIR /app/build/backends/openvino/test
RUN . /opt/test_env/bin/activate && \
    python3 export_torchvision_classifier.py && \
    . ${OPENVINO_DIR}/python_env/bin/activate && \
    LD_LIBRARY_PATH=${OPENVINO_DIR}/runtime/lib/intel64:${LD_LIBRARY_PATH:-} ./generate_openvino_ir.sh

# Stage 5: Final runtime image for testing
FROM openvino_install AS final

# Create non-root user
RUN useradd -m testuser && \
    mkdir -p /app && \
    chown -R testuser:testuser /app

# Copy built binaries and test files
COPY --from=model_generator --chown=testuser:appuser /app/build /app/build
COPY --from=model_generator --chown=testuser:appuser /app/backends/openvino/test /app/backends/openvino/test
COPY --from=model_generator --chown=testuser:appuser /app/build/backends/openvino/test/resnet18.xml /app/
COPY --from=model_generator --chown=testuser:appuser /app/build/backends/openvino/test/resnet18.bin /app/

# Set working directory
WORKDIR /app

# Switch to test user
USER testuser

# Set library path
ENV LD_LIBRARY_PATH=/app/build/lib:${OPENVINO_DIR}/lib

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD test -f /app/build/lib/libneuriplo.so || exit 1

# Default command to run OpenVINO tests
CMD ["/app/build/backends/openvino/test/OpenVINOInferTest"] 