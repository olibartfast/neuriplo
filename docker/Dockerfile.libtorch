# docker build --rm -t neuriplo:libtorch -f docker/Dockerfile.libtorch .
# docker run --rm neuriplo:libtorch

# Stage 1: Base image with system dependencies
ARG BASE_IMAGE=base
FROM ubuntu:24.04 AS base

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV LIBTORCH_DIR=/opt/libtorch
ENV DEPENDENCIES_DIR=/opt/dependencies

# Load versions from versions.env
COPY versions.env /tmp/versions.env
RUN set -a && . /tmp/versions.env && set +a && \
    echo "PYTORCH_VERSION=${PYTORCH_VERSION}" && \
    echo "Loaded PyTorch version: ${PYTORCH_VERSION}" && \
    export LIBTORCH_VERSION=${PYTORCH_VERSION}

# Install system dependencies
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y \
    cmake=3.* \
    clang-tidy-18 \
    build-essential=12.* \
    libgoogle-glog-dev \
    libgtest-dev \
    libgmock-dev \
    wget \
    git \
    curl \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    ninja-build \
    pkg-config \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Stage 2: Install LibTorch C++ SDK
FROM ${BASE_IMAGE} AS libtorch_install

# Refresh the pin even when inheriting a published dependency image.
COPY versions.env /tmp/versions.env
COPY scripts/ci/check_libtorch_sdk.py /opt/neuriplo-ci/check_libtorch_sdk.py
ARG COMPUTE_PLATFORM=cpu
RUN . /tmp/versions.env && \
    if [ -d "${LIBTORCH_DIR}" ]; then \
        python3 /opt/neuriplo-ci/check_libtorch_sdk.py --root "${LIBTORCH_DIR}" \
            --version "${PYTORCH_VERSION}" --platform "${COMPUTE_PLATFORM}" && \
        echo "LibTorch SDK already installed, skipping download."; \
    else \
        wget -O /tmp/libtorch.zip "https://download.pytorch.org/libtorch/${COMPUTE_PLATFORM}/libtorch-shared-with-deps-${PYTORCH_VERSION}%2B${COMPUTE_PLATFORM}.zip" && \
        unzip -q /tmp/libtorch.zip -d /tmp && mv /tmp/libtorch "${LIBTORCH_DIR}" && \
        rm /tmp/libtorch.zip; \
    fi && \
    python3 /opt/neuriplo-ci/check_libtorch_sdk.py --root "${LIBTORCH_DIR}" \
        --version "${PYTORCH_VERSION}" --platform "${COMPUTE_PLATFORM}"

# Set LibTorch environment variables
ENV LIBTORCH_DIR=/opt/libtorch
ENV LD_LIBRARY_PATH=${LIBTORCH_DIR}/lib
ENV CMAKE_PREFIX_PATH=${LIBTORCH_DIR}

# The reusable image includes the matching CPU exporter environment. Keep model
# weights and project sources out of this dependency layer.
RUN if [ ! -x /opt/pytorch_env/bin/python ]; then python3 -m venv /opt/pytorch_env; fi
ENV PATH=/opt/pytorch_env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN . /tmp/versions.env && \
    if /opt/pytorch_env/bin/python -c 'import torch, torchvision, onnx, numpy, pytest; import sys; assert torch.__version__ == sys.argv[1] + "+cpu"' "${PYTORCH_VERSION}"; then \
        echo "Python Torch dependencies already installed, skipping pip install."; \
    else \
        pip install --no-cache-dir "torch==${PYTORCH_VERSION}" torchvision --index-url https://download.pytorch.org/whl/cpu && \
        pip install --no-cache-dir onnx numpy pytest pytest-cov pytest-mock pytest-benchmark pytest-xdist \
            coverage pytest-html pytest-json-report; \
    fi && \
    python3 /opt/neuriplo-ci/check_libtorch_sdk.py --root "${LIBTORCH_DIR}" \
        --version "${PYTORCH_VERSION}" --platform "${COMPUTE_PLATFORM}" --python /opt/pytorch_env/bin/python && \
    pip check

COPY scripts/ci/libtorch-sdk-smoke /opt/neuriplo-ci/libtorch-sdk-smoke
RUN . /tmp/versions.env && \
    if [ -x /opt/neuriplo-ci/libtorch_sdk_smoke ] && \
       (cd /opt/neuriplo-ci/libtorch-sdk-smoke && sha256sum --check /opt/neuriplo-ci/libtorch-sdk-smoke.sources); then \
        echo "Reusing compiled SDK smoke test."; \
    else \
        cmake -S /opt/neuriplo-ci/libtorch-sdk-smoke -B /tmp/libtorch-sdk-smoke \
            -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH="${LIBTORCH_DIR}" && \
        cmake --build /tmp/libtorch-sdk-smoke --parallel 2 && \
        /tmp/libtorch-sdk-smoke/libtorch_sdk_smoke "${PYTORCH_VERSION}" "${COMPUTE_PLATFORM}" && \
        cp /tmp/libtorch-sdk-smoke/libtorch_sdk_smoke /opt/neuriplo-ci/libtorch_sdk_smoke && \
        (cd /opt/neuriplo-ci/libtorch-sdk-smoke && sha256sum CMakeLists.txt main.cpp > /opt/neuriplo-ci/libtorch-sdk-smoke.sources) && \
        rm -rf /tmp/libtorch-sdk-smoke; \
    fi && \
    /opt/neuriplo-ci/libtorch_sdk_smoke "${PYTORCH_VERSION}" "${COMPUTE_PLATFORM}"

# Stage 3: Build application
FROM libtorch_install AS builder

WORKDIR /app

# Copy source code
COPY . .

# Parallel compile jobs. Each LibTorch translation unit needs about 1 GB, so
# memory-constrained hosts should pass a small value (--build-arg BUILD_JOBS=2).
ARG BUILD_JOBS=""

# Build the project with LibTorch backend and tests enabled
RUN rm -rf build && \
    cmake -Bbuild -H. \
    -DDEFAULT_BACKEND=LIBTORCH \
    -DBUILD_INFERENCE_ENGINE_TESTS=ON \
    -DCMAKE_PREFIX_PATH=${LIBTORCH_DIR} \
    -DLIBTORCH_DIR=${LIBTORCH_DIR} \
    && cmake --build build --config Release -j${BUILD_JOBS:-$(nproc)}

# Stage 4: Generate test models
FROM builder AS model_generator

# SDK and Python exporter dependencies were verified in libtorch_install.

# Generate LibTorch model using model_downloader.py
WORKDIR /app/build/backends/libtorch/test
RUN /opt/pytorch_env/bin/python /app/scripts/model_downloader.py LIBTORCH --output-dir . --keep-temp
# AOTInductor compiles with one worker per core unless told otherwise.
ARG BUILD_JOBS=""
RUN TORCHINDUCTOR_COMPILE_THREADS=${BUILD_JOBS:-$(nproc)} \
    /opt/pytorch_env/bin/python /app/scripts/model_downloader.py LIBTORCH_AOTI --output-dir . --keep-temp --path-file aoti_model_path.txt

# Stage 5: Final runtime image for testing
FROM libtorch_install AS final

# Create non-root user
RUN useradd -m testuser && \
    mkdir -p /app && \
    chown -R testuser:testuser /app

# Copy built binaries and test files
COPY --from=model_generator --chown=testuser:testuser /app/build /app/build
COPY --from=model_generator --chown=testuser:testuser /app/backends/libtorch/test /app/backends/libtorch/test

# Set working directory to where the test files are located
WORKDIR /app/build/backends/libtorch/test

# Switch to test user
USER testuser

# Set library path
ENV LD_LIBRARY_PATH=/app/build/lib:${LIBTORCH_DIR}/lib

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD test -f /app/build/lib/libneuriplo.so || exit 1

# Default command to run LibTorch tests
CMD ["./LibtorchInferTest"] 