# CPU (default) image:
#   docker build --rm -t neuriplo:libtensorflow -f docker/Dockerfile.libtensorflow .
#   docker run --rm neuriplo:libtensorflow
#
# Optional GPU image (opt-in, CPU behaviour is unchanged):
#   docker build --rm -t neuriplo:libtensorflow-gpu \
#     --build-arg TF_BASE_IMAGE=nvidia/cuda:12.6.1-cudnn-runtime-ubuntu24.04 \
#     --build-arg TF_GPU=1 \
#     -f docker/Dockerfile.libtensorflow .
#   docker run --rm --gpus all neuriplo:libtensorflow-gpu
# The GPU build needs the NVIDIA Container Toolkit and a host driver at run
# time; at build time it only needs the CUDA/cuDNN runtime image. The CPU
# image is the default because TF_BASE_IMAGE defaults to ubuntu:24.04. Do not
# combine TF_BASE_IMAGE with the prebuilt BASE_IMAGE SDK override.
#
# TensorFlow 2.19.0 is tested against CUDA 12.5 and cuDNN 9.3. The pinned
# nvidia/cuda:12.6.1-cudnn-runtime-ubuntu24.04 tag provides CUDA 12.6.1 and
# cuDNN 9.3.0, matching the cuDNN line and staying within CUDA 12.x minor
# version compatibility.

# Stage 1: Base image with system dependencies
# Prebuilt SDK base override: defaults to the stage below so local builds are
# unchanged; CI passes BASE_IMAGE=ghcr.io/<repo>/tensorflow-deps:<ver>.
ARG BASE_IMAGE=base
# CPU default. Set to a CUDA/cuDNN runtime image for the opt-in GPU build.
ARG TF_BASE_IMAGE=ubuntu:24.04
FROM ${TF_BASE_IMAGE} AS base

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV TENSORFLOW_DIR=/opt/tensorflow
ENV DEPENDENCIES_DIR=/opt/dependencies
# Preserve the CUDA runtime image's library paths instead of wiping them; on a
# CPU base these extra directories simply do not exist.
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:${LD_LIBRARY_PATH:-}
ENV PKG_CONFIG_PATH=""

# Load versions from versions.env
COPY versions.env /tmp/versions.env
RUN set -a && . /tmp/versions.env && set +a && \
    echo "TENSORFLOW_VERSION=${TENSORFLOW_VERSION}" && \
    echo "Loaded TensorFlow version: ${TENSORFLOW_VERSION}"

# Install system dependencies
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y \
    cmake=3.* \
    build-essential=12.* \
    libgoogle-glog-dev \
    libgtest-dev \
    libgmock-dev \
    wget \
    git \
    curl \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    ninja-build \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Stage 2: Install TensorFlow
FROM ${BASE_IMAGE} AS tensorflow_install

# Use the requested repository pin even when inheriting a published SDK.
COPY versions.env /tmp/versions.env

# Create virtual environment for TensorFlow
RUN python3 -m venv /opt/tensorflow_env
ENV PATH=/opt/tensorflow_env/bin:$PATH

# Install TensorFlow and dependencies
RUN . /tmp/versions.env && \
    if [ -f /opt/tensorflow/lib/libtensorflow_cc.so ] && [ "$(cat /opt/tensorflow/tensorflow-version.txt 2>/dev/null)" = "${TENSORFLOW_VERSION}" ] && [ "$(pip show tensorflow 2>/dev/null | awk '/^Version: /{print $2}')" = "${TENSORFLOW_VERSION}" ]; then \
        echo "TensorFlow ${TENSORFLOW_VERSION} already installed, skipping pip install."; \
    else \
    pip install --upgrade pip && \
    pip install "tensorflow==${TENSORFLOW_VERSION}" && \
    pip check; \
    fi

# Verify installation
RUN . /tmp/versions.env && \
    python -c 'import sys, tensorflow as tf; assert tf.__version__ == sys.argv[1], (tf.__version__, sys.argv[1]); print("TensorFlow version:", tf.__version__)' "${TENSORFLOW_VERSION}"

# Setup TensorFlow C++ libraries (following setup_tensorflow_pip.sh pattern)
RUN . /tmp/versions.env && \
    if [ -f ${TENSORFLOW_DIR}/lib/libtensorflow_cc.so ] && [ "$(cat ${TENSORFLOW_DIR}/tensorflow-version.txt 2>/dev/null)" = "${TENSORFLOW_VERSION}" ]; then \
        echo "TensorFlow ${TENSORFLOW_VERSION} C++ libraries already staged, skipping."; \
    else \
    TF_SITE_PACKAGES=/opt/tensorflow_env/lib/python3.12/site-packages/tensorflow && \
    mkdir -p ${TENSORFLOW_DIR}/lib ${TENSORFLOW_DIR}/include && \
    cp ${TF_SITE_PACKAGES}/libtensorflow_cc.so.2 ${TENSORFLOW_DIR}/lib/ && \
    cp ${TF_SITE_PACKAGES}/libtensorflow_framework.so.2 ${TENSORFLOW_DIR}/lib/ && \
    ln -sf libtensorflow_cc.so.2 ${TENSORFLOW_DIR}/lib/libtensorflow_cc.so && \
    ln -sf libtensorflow_framework.so.2 ${TENSORFLOW_DIR}/lib/libtensorflow_framework.so && \
    cp -r ${TF_SITE_PACKAGES}/include/* ${TENSORFLOW_DIR}/include/ && \
    [ -d "${TF_SITE_PACKAGES}/core" ] && cp -r ${TF_SITE_PACKAGES}/core ${TENSORFLOW_DIR}/include/tensorflow/ || true && \
    [ -d "${TF_SITE_PACKAGES}/cc" ] && cp -r ${TF_SITE_PACKAGES}/cc ${TENSORFLOW_DIR}/include/tensorflow/ || true && \
    echo "${TENSORFLOW_VERSION}" > ${TENSORFLOW_DIR}/tensorflow-version.txt; \
    fi

# Create pkg-config file
RUN . /tmp/versions.env && \
    mkdir -p ${TENSORFLOW_DIR}/lib/pkgconfig && \
    cat > ${TENSORFLOW_DIR}/lib/pkgconfig/tensorflow.pc << EOF
prefix=${TENSORFLOW_DIR}
libdir=\${prefix}/lib
includedir=\${prefix}/include
Name: TensorFlow
Version: ${TENSORFLOW_VERSION}
Libs: -L\${libdir} -ltensorflow_cc -ltensorflow_framework
Cflags: -I\${includedir}
EOF

# Set TensorFlow environment variables
ENV TENSORFLOW_DIR=/opt/tensorflow
ENV LD_LIBRARY_PATH=${TENSORFLOW_DIR}/lib:${LD_LIBRARY_PATH:-}
ENV PKG_CONFIG_PATH=${TENSORFLOW_DIR}/lib/pkgconfig:${PKG_CONFIG_PATH:-}

# Stage 3: Build application
FROM tensorflow_install AS builder

WORKDIR /app

# Copy source code
COPY . .

# Additional dependencies are already installed in tensorflow_install stage

# Build the project with TensorFlow backend and tests enabled
RUN rm -rf build && \
    cmake -Bbuild -H. \
    -DDEFAULT_BACKEND=LIBTENSORFLOW \
    -DBUILD_INFERENCE_ENGINE_TESTS=ON \
    -DTENSORFLOW_DIR=${TENSORFLOW_DIR} \
    && cmake --build build --config Release -j$(nproc)

# Record link resolution as build evidence. The GPU build additionally asserts
# that the CUDA/cuDNN runtime is present in the image; TensorFlow loads those
# libraries dynamically, so they are not always DT_NEEDED entries. libcuda.so.1
# is a host-driver library and is intentionally absent at build time.
ARG TF_GPU=0
RUN set -eux; \
    ldd build/libneuriplo.so > /tmp/ldd-neuriplo.txt 2>&1; \
    cat /tmp/ldd-neuriplo.txt; \
    ldd "${TENSORFLOW_DIR}/lib/libtensorflow_cc.so.2" > /tmp/ldd-tensorflow.txt 2>&1 || true; \
    cat /tmp/ldd-tensorflow.txt; \
    if [ "${TF_GPU}" = "1" ]; then \
        for lib in 'libcudart\.so\.12' 'libcublas\.so\.12' 'libcudnn\.so\.9'; do \
            ldconfig -p | grep -E "${lib}" >/dev/null || { echo "missing GPU runtime: ${lib}"; exit 1; }; \
        done; \
        echo "CUDA/cuDNN runtime libraries found"; \
    fi

# Stage 4: Generate test models
FROM builder AS model_generator

# Generate TensorFlow SavedModel using model_downloader.py
WORKDIR /app/build/backends/libtensorflow/test
RUN . /opt/tensorflow_env/bin/activate && \
    /opt/tensorflow_env/bin/python /app/scripts/model_downloader.py LIBTENSORFLOW --output-dir . --keep-temp

# Stage 5: Final runtime image for testing
FROM tensorflow_install AS final

# Create non-root user
RUN useradd -m testuser && \
    mkdir -p /app && \
    chown -R testuser:testuser /app

# Copy built binaries and test files
COPY --from=model_generator --chown=testuser:testuser /app/build /app/build
COPY --from=model_generator --chown=testuser:testuser /app/backends/libtensorflow/test /app/backends/libtensorflow/test

# Set working directory to where the test files are located
WORKDIR /app/build/backends/libtensorflow/test

# Switch to test user
USER testuser

# Set library path. /app/build carries libneuriplo.so; the CUDA paths are kept
# from the base image so the opt-in GPU runtime can load cuDNN/cuBLAS at run time.
ENV LD_LIBRARY_PATH=/app/build:${TENSORFLOW_DIR}/lib:/opt/tensorflow_env/lib/python3.12/site-packages/tensorflow:/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:${LD_LIBRARY_PATH:-}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD test -f /app/build/libneuriplo.so || exit 1

# Invalid supplied fixtures must fail, never switch to mock outputs.
RUN ctest --test-dir /app/build -R TensorFlowSuppliedFixture --output-on-failure

# Default command to run TensorFlow tests
CMD ["./TensorFlowInferTest"] 