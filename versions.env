# ==============================================================================
# Backend Version Configuration for neuriplo
# ==============================================================================
#
# This file defines version numbers for all backend dependencies.
# Version variables are automatically read by CMake and shell scripts.
#
# HOW TO ADD A NEW BACKEND VERSION:
# ----------------------------------
# 1. Add the version variable here:
#      NEW_BACKEND_VERSION=1.0.34
#
# 2. Add corresponding cache variable to cmake/versions.cmake:
#      set(NEW_BACKEND_VERSION "${NEW_BACKEND_VERSION}" CACHE STRING "New Backend version")
#
# 3. Add to BACKEND_VERSION_MAPPING in cmake/versions.cmake:
#      "NEW_BACKEND:NEW_BACKEND_VERSION"
#
# 4. Update backend arrays in scripts that need the backend name
#
# VALIDATION:
# -----------
# Run cmake to validate (validation happens automatically):
#   cmake ..
#
# ==============================================================================

# Backend versions
OPENVINO_VERSION=2026.3.0
OPENVINO_FULL_ID=2026.3.0.22451.bd8d6542e3c
TENSORFLOW_VERSION=2.19.0
PYTORCH_VERSION=2.14.0
TENSORRT_VERSION=11.2.1.2
ONNX_RUNTIME_VERSION=1.28.0
OPENCV_VERSION=4.6.0
GGML_VERSION=v0.11.0
TVM_VERSION=0.22.0
MIGRAPHX_VERSION=2.12.0
CACTUS_VERSION=v1.14
LLAMACPP_VERSION=b9085
EXECUTORCH_VERSION=v1.2.0
LITERT_VERSION=2.19.0

# CUDA version for GPU backends
CUDA_VERSION=13.4.1
# CUDA line of the TensorRT build: the `cuda-<v>` tag in the TensorRT tarball
# name. TensorRT 11.2.1.2 is published for CUDA 13.3 and 12.9 only, and runs on
# the 13.4 toolkit above through CUDA minor-version compatibility.
TENSORRT_CUDA_VERSION=13.3


# Docker configuration
DOCKER_BASE_IMAGE=ubuntu:24.04
DOCKER_USER=testuser
DOCKER_WORKDIR=/app

# NVIDIA DALI (GPU preprocessing backend). The C++ distribution ships inside
# the nvidia-dali pip wheel; point the build at an extracted copy with DALI_DIR.
DALI_VERSION=2.2.0

# NERT (Neuriplo Engine Runtime), experimental first-party backend consumed with
# CMake FetchContent from https://github.com/olibartfast/nert (cmake/Nert.cmake).
# Commit of olibartfast/nert main; a tag replaces it at NERT's first release.
NERT_VERSION=81b6b1f824655403742e727853afe05261dae5d0
